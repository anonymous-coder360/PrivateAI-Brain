# ==========================================
# GIT LFS TRACKING (for large files)
# ==========================================
# Run: git lfs install
# git lfs track "*.gguf"
# git lfs track "*.bin"
# git lfs track "*.pt"
# git lfs track "*.safetensors"
# git lfs track "*.pth"
# git lfs track "*.onnx"
# git lfs track "*.arrow"